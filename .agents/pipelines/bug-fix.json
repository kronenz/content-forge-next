{
  "$schema": "../schemas/pipeline.schema.json",
  "pipeline_id": "bug-fix",
  "name": "버그 수정 파이프라인",
  "description": "버그 발견 시 최소 변경 원칙으로 수정",

  "phases": [
    {
      "phase": "diagnose",
      "executor": "orchestrator",
      "steps": [
        "에러 로그/재현 방법 확인",
        "원인 파일 및 라인 특정",
        "담당 에이전트 결정 (scope 기반)"
      ]
    },
    {
      "phase": "fix",
      "executor": "assigned-agent",
      "rules": [
        "최소 변경 원칙 — 버그와 직접 관련된 코드만 수정",
        "리팩토링 금지 — 버그 수정과 개선을 분리",
        "수정 전 기존 동작 이해 필수"
      ]
    },
    {
      "phase": "regression-test",
      "executor": "qa",
      "steps": [
        "수정 사항에 대한 테스트 케이스 추가",
        "기존 테스트 전체 실행"
      ]
    },
    {
      "phase": "verify",
      "executor": "orchestrator",
      "steps": ["lint", "typecheck", "test", "build"]
    }
  ]
}
