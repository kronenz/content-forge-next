{
  "$schema": "../schemas/contract.schema.json",
  "contract_id": "devops-all",
  "version": "1.0.0",
  "description": "DevOps Agent와 전체 에이전트 간의 인프라 계약",

  "parties": {
    "provider": "devops",
    "consumers": ["frontend", "ui", "backend-api", "db", "ai-pipeline", "collector", "publisher", "qa"]
  },

  "interfaces": {
    "local_dev": {
      "description": "로컬 개발 환경",
      "commands": {
        "make dev": "Next.js 개발 서버 (bun dev --turbopack)",
        "make up": "Docker 전체 스택 (app + postgres + redis)",
        "make down": "Docker 중지",
        "make db-push": "Drizzle 스키마 DB 반영",
        "make db-studio": "Drizzle Studio (DB GUI)"
      }
    },
    "ci_pipeline": {
      "description": "CI/CD 파이프라인",
      "location": ".github/workflows/",
      "stages": ["lint", "typecheck", "test", "build", "docker-build", "lighthouse"],
      "pass_criteria": {
        "lint": "bun run lint 통과",
        "typecheck": "bun run typecheck 통과",
        "test": "bun run test 통과 (Postgres + Redis 서비스 컨테이너)",
        "build": "bun run build 성공",
        "lighthouse_seo": "> 95",
        "lighthouse_perf": "> 90"
      }
    },
    "docker": {
      "description": "컨테이너 구성",
      "files": {
        "Dockerfile": "멀티스테이지 빌드 (deps → builder → runner)",
        "docker-compose.yml": "로컬 개발 (app + postgres + redis)",
        "docker-compose.test.yml": "테스트 전용 (일회성)"
      },
      "ports": {
        "app": 3000,
        "postgres": 5432,
        "redis": 6379
      }
    },
    "env_vars": {
      "description": "환경 변수 관리",
      "template": ".env.example",
      "local": ".env.local (git 미추적)",
      "validation": "src/lib/env.ts (Zod 스키마)",
      "rules": [
        ".env.local은 절대 커밋하지 않음",
        "새 환경 변수 추가 시 .env.example과 src/lib/env.ts 동시 업데이트",
        "NEXT_PUBLIC_ 접두사: 클라이언트 노출, 그 외: 서버 전용"
      ]
    }
  },

  "constraints": [
    "인프라 파일 수정은 DevOps Agent만 수행",
    "다른 에이전트는 Makefile 명령어를 실행만 가능 (수정 금지)",
    "CI 통과 기준 변경 시 반드시 팀 합의 (CLAUDE.md 반영)"
  ]
}
